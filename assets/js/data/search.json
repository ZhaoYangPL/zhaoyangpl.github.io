---
layout: compress
swcache: true
---

[
  {% assign search_posts = site.posts | where_exp: 'item', 'item.hidden != true' %}
  {% for post in search_posts %}
  {
    "title": {% if post.private %}{{ post.title | prepend: '🔒 ' | jsonify }}{% else %}{{ post.title | jsonify }}{% endif %},
    "url": {{ post.url | relative_url | jsonify }},
    "categories": {{ post.categories | join: ', ' | jsonify }},
    "tags": {% if post.private %}""{% else %}{{ post.tags | join: ', ' | jsonify }}{% endif %},
    "date": {{ post.date | jsonify }},
    "content": {% include post-description.html json=true %}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
